#!/usr/bin/env bash
# Thin docker compose wrapper: bin/dc up -d db redis, bin/dc build app, ...
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
export DC_UID="${DC_UID:-$(id -u)}" DC_GID="${DC_GID:-$(id -g)}"
mkdir -p tmp/packet
# Disposable local encryption keys, generated once and kept in the ignored tmp/ directory.
keys=tmp/dev-encryption.env
if [ ! -s "$keys" ]; then
  {
    echo "ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(openssl rand -hex 16)"
    echo "ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(openssl rand -hex 16)"
    echo "ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(openssl rand -hex 16)"
  } > "$keys"
fi
set -a; . "$keys"; set +a
exec docker compose -f docker-compose.yml "$@"
