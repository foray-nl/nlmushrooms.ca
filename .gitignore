# Ignore bundler config and installed gems.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*
!/.env.sample

# Ignore all logs and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# Ignore local storage and keys. Never commit a key file.
/storage/*
!/storage/.keep
/config/master.key
/config/credentials/*.key

/public/assets
/public/packs*
/node_modules
/coverage
/.rspec_status
__pycache__/
